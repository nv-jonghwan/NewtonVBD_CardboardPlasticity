#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @demo_scene_robotiq_board10_primitive.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Physics"
    {
        float cardboard:graspForce = 160
    }

    over "Box"
    {
        over "Materials"
        {
            over "Cardboard"
            {
                float cardboard:bendingCD = 0.41666663
                float cardboard:bendingMD = 0.83333325
            }
        }
    }
}

