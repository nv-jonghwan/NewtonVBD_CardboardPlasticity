#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "Physics" (
        prepend apiSchemas = ["CardboardDemoAPI", "CardboardScenarioAPI"]
    )
    {
        float cardboard:approachClearance = 0.2
        rel cardboard:box = </World/Box>
        float cardboard:contactDamping = 0.9
        float cardboard:contactStiffness = 180000
        custom bool cardboard:coupledSupportedSolve = 1
        float cardboard:crushForce = 4000
        float cardboard:crushGap = 0.14
        float cardboard:crushRampFraction = 0.65
        float cardboard:duration = 11
        rel cardboard:fingerJoints = [
            </World/Gripper/finger_joint>,
            </World/Gripper/right_outer_knuckle_joint>,
        ]
        float cardboard:fingerPositionStiffness = 32000
        float cardboard:fingerVelocityDamping = 180
        float cardboard:fps = 60
        float cardboard:graspForce = 250
        float cardboard:graspGap = 0.27
        custom float cardboard:graspRampFraction = 0.7
        float cardboard:gravityRampSeconds = 1
        custom string cardboard:gripperModel = "robotiq_scaled"
        custom float cardboard:gripperScale = 2.3
        float3 cardboard:homeOffset = (-0.22, 0, 0.24)
        int cardboard:iterations = 48
        bool cardboard:kinematicArm = 1
        float cardboard:liftHeight = 0.12
        custom float cardboard:liftMoveFraction = 0.85
        float cardboard:maxFingerForce = 30
        float cardboard:maxWristTorque = 2
        float cardboard:minimumGap = 0.16
        float cardboard:openGap = 0.322
        custom int cardboard:particleSolveInterval = 3
        float[] cardboard:phaseEnds = [1, 3, 5, 7, 9, 12, 13, 16]
        bool cardboard:precomputeCommands = 1
        bool cardboard:realtimePacing = 0
        float cardboard:releaseRampFraction = 0.25
        custom bool cardboard:restRefinement = 1
        bool cardboard:rigidCompliantALM = 0
        rel cardboard:robot = </World/UR10>
        custom float cardboard:robotiqDriveDamping = 160
        custom float cardboard:robotiqDriveStiffness = 8000
        custom float cardboard:robotiqPinchDamping = 160
        custom float cardboard:robotiqPinchStiffness = 8000
        custom bool cardboard:rotationBlockSolve = 1
        custom float cardboard:selfContactRestExclusion = 0.010009999
        custom int cardboard:sleepIterations = 8
        custom bool cardboard:smoothMotion = 1
        int cardboard:substeps = 16
        custom bool cardboard:supportedSleep = 1
        custom float cardboard:toolReach = 0.4237198
        bool cardboard:translationBlockSolve = 1
        float cardboard:twistRadians = 0.12
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "Box" (
        prepend references = @./cardboard_robotiq_board10.usda@
    )
    {
        double3 xformOp:translate = (0.32, 0, 0.7520854188524186)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "RenderMesh"
        {
            float cardboard:visualCreaseAngleDegrees = 80
            float cardboard:visualCreaseTransitionDegrees = 40
            custom bool cardboard:visualSmoothThickness = 1
        }

        over "Materials"
        {
            over "Cardboard"
            {
                float cardboard:arealDensity = 1.8000001
                float cardboard:bendingRelaxationTime = 0.02
                custom float cardboard:creaseDamageLength = 0.013333333
                float cardboard:damageRate = 4
                float cardboard:hardeningRatio = 0.01
                custom float cardboard:internalVelocityDamping = 60
                float cardboard:membraneArea = 58800
                float cardboard:membraneShear = 35280
                float cardboard:residualStiffness = 0.18
                custom float cardboard:supportedInternalDamping = 120
                custom float cardboard:supportedRigidDamping = 20
                float cardboard:thickness = 0.01
                float cardboard:yieldCurvature = 6
            }
        }
    }

