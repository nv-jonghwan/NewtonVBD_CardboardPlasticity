#usda 1.0
(
    defaultPrim = "World"
    doc = "Fixed material and continuous grasp/lift force tuning; original primitive scene retained as the base. See docs/2026-10-01_grasp-and-sag-tuning-ko.md."
    metersPerUnit = 1
    subLayers = [
        @demo_scene_robotiq_board10_primitive.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Box"
    {
        over "Materials"
        {
            over "Cardboard"
            {
                float cardboard:bendingCD = 4.444444
                float cardboard:bendingMD = 8.888888
                float cardboard:damageRate = 400
                float cardboard:hardeningRatio = 0.000625
                float cardboard:residualStiffness = 0.01125
                float cardboard:yieldCurvature = 0.375
            }
        }
    }

    over "Physics"
    {
        float cardboard:crushForce = 6000
        float cardboard:graspForce = 750
        custom float cardboard:graspRampFraction = 0.5
        float cardboard:liftForce = 200
        float cardboard:rigidJointLinearStiffness = 200000
        int cardboard:rigidParticleContactCapacity = 512
    }
}

