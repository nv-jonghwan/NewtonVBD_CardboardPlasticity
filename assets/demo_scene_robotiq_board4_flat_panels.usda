#usda 1.0
(
    metersPerUnit = 1
    subLayers = [
        @demo_scene_robotiq_board4_graded.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Box"
    {
        over "RenderMesh"
        {
            float cardboard:visualCreaseAngleDegrees = 35
            float cardboard:visualCreaseTransitionDegrees = 20
        }
    }
}

